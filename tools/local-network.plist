<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the app's Info.plist. macOS 15 and later only let an app
     reach the LAN after the user allows it, and this is the text that the
     "find devices on your local network" prompt shows. -->
<plist version="1.0">
<dict>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Scope Remote talks to your oscilloscope over the local network.</string>
</dict>
</plist>
